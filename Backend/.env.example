# Backend Environment Variables Schema Template

PORT=5000
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/realtimechat?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_signing_key_here

# Cloudinary Storage Configuration
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Google Gemini AI Integration
GEMINI_API_KEY=your_google_gemini_api_key_1
GEMINI_API_KEY_2=your_google_gemini_api_key_2

# Email & Notification Services
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_email_app_password
RESEND_API_KEY=your_resend_api_key

# Web Push VAPID Keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Frontend Allowed Origin
FRONTEND_URL=http://localhost:5173
